  {
   "type": "text",
   "id": "g_data_t",
   "x": 78,
   "y": 910,
   "width": 410,
   "height": 210,
   "text": "23 judge cases, answers known by construction\nfrom real claims + real page snapshots:\n  unchanged  = claim as stated\n  changed    = its number altered\n  unverified = its passages removed\nsplit by vendor: train / val / test\n\nwritten feedback GEPA reads:\n  claim \"Freshsales Growth: $11\" →\n  answered unverified, should be\n  changed: the evidence shows $9",
   "originalText": "23 judge cases, answers known by construction\nfrom real claims + real page snapshots:\n  unchanged  = claim as stated\n  changed    = its number altered\n  unverified = its passages removed\nsplit by vendor: train / val / test\n\nwritten feedback GEPA reads:\n  claim \"Freshsales Growth: $11\" →\n  answered unverified, should be\n  changed: the evidence shows $9",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
