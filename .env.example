# ── Required ─────────────────────────────────────────────
# Models: answer (gpt-6.1-sol), routing (gpt-6-luna), extraction (gpt-6.1-terra), embeddings.
OPENAI_API_KEY=

# Web search: at least one provider. Exa is the default (free tier, no card).
EXA_API_KEY=

# ── Optional ─────────────────────────────────────────────
# A second search provider. Every configured provider is queried in parallel
# and the results are merged. Tavily: free tier, no card. Brave: free tier needs a card.
TAVILY_API_KEY=
BRAVE_API_KEY=

# Limit which configured providers are used, e.g. "exa" or "exa,tavily".
# SEARCH_PROVIDERS=

# Override models.
# MODEL_ANSWER=gpt-6.1-sol
# MODEL_ROUTER=gpt-6-luna
# MODEL_EXTRACT=gpt-6.1-terra
# MODEL_JUDGE=gpt-6.1-terra
# MODEL_EMBED=text-embedding-3-small
# REASONING_EFFORT=low        # none | low | medium | high | off (all roles)
# REASONING_EFFORT_ROUTER=none  # per role: _ROUTER, _JUDGE, _EXTRACT, _ANSWER

# Your timezone when the browser doesn't send one (dates like "last Tuesday" use it).
# USER_TZ=Asia/Kolkata

# Hours after an answer before its claims are proactively re-checked (0 = off).
# RECHECK_AFTER_HOURS=24

# PORT=3000
# DATA_DIR=./data
